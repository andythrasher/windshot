<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windshot.Shell.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to Windshot">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- The same cards as the settings window. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="60" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,18,0,6" />
            </Style>
            <Style x:Key="Description" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Problem" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="ShortcutButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="168" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            </Style>
            <Style x:Key="TrayGlyph" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <ScrollViewer>
            <StackPanel Margin="28,24,28,20" Spacing="4">
                <Grid ColumnSpacing="16" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Icon" Width="56" Height="56" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Welcome to Windshot" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource Description}" FontSize="14"
                                   Text="It waits in the background until you need it, so there's no window to keep open." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Find it in the notification area" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- A sketch of the taskbar's corner, with Windshot's icon picked out. -->
                        <Border VerticalAlignment="Center" Padding="10,6" CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE70E;" Style="{StaticResource TrayGlyph}" FontSize="12" VerticalAlignment="Center" />
                                <Border Padding="4" CornerRadius="4" BorderThickness="1.5"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image x:Name="TrayIcon" Width="20" Height="20" />
                                </Border>
                                <FontIcon Glyph="&#xE701;" Style="{StaticResource TrayGlyph}" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE767;" Style="{StaticResource TrayGlyph}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrayClock" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock TextWrapping="Wrap" Text="Click Windshot's icon to capture, or right-click it for more, including Settings." />
                            <TextBlock Style="{StaticResource Description}"
                                       Text="If it isn't there, Windows has tucked it under the arrow. Drag it onto the taskbar to keep it in view." />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Shortcuts" Style="{StaticResource Section}" />
                <TextBlock Margin="2,-2,0,6" Style="{StaticResource Description}"
                           Text="They work from anywhere. To change one, click it and press the keys you want." />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Capture" />
                            <TextBlock Style="{StaticResource Description}" Text="Select a region or click a window, then edit it." />
                            <TextBlock x:Name="CaptureProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="CaptureShortcut" Style="{StaticResource ShortcutButton}" />
                            <Button x:Name="CaptureReset" ToolTipService.ToolTip="Reset to the default" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Scrolling capture" />
                            <TextBlock Style="{StaticResource Description}" Text="Capture more than fits on screen by scrolling." />
                            <TextBlock x:Name="ScrollingProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="ScrollingShortcut" Style="{StaticResource ShortcutButton}" />
                            <Button x:Name="ScrollingReset" ToolTipService.ToolTip="Reset to the default" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Copy text" />
                            <TextBlock Style="{StaticResource Description}" Text="Select a region and copy the text in it." />
                            <TextBlock x:Name="CopyTextProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="CopyTextShortcut" Style="{StaticResource ShortcutButton}" />
                            <Button x:Name="CopyTextReset" ToolTipService.ToolTip="Reset to the default" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Record video" />
                            <TextBlock Style="{StaticResource Description}" Text="Record an area or window, with the PC's sound. Press it again to stop." />
                            <TextBlock x:Name="RecordProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="RecordShortcut" Style="{StaticResource ShortcutButton}" />
                            <Button x:Name="RecordReset" ToolTipService.ToolTip="Reset to the default" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Make it yours" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Editor theme" />
                            <TextBlock Style="{StaticResource Description}" Text="This window shows how it looks." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel x:Name="WindowThemePreview" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                            <ComboBox x:Name="WindowTheme" MinWidth="168" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource Description}" Text="Be ready, with your pins, after you sign in." />
                            <TextBlock x:Name="StartWithWindowsProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartWithWindows" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="28,14" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ShowAtStart" Content="Show this when Windshot starts" VerticalAlignment="Center" />
                <Button x:Name="TryCapture" Grid.Column="1" Content="Try a capture" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
                <Button x:Name="Done" Grid.Column="2" Content="Done" MinWidth="96" />
            </Grid>
        </Border>
    </Grid>
</Window>
