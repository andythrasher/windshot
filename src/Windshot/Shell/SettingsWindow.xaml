<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windshot.Shell.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windshot settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- One setting per card, like Windows Settings: what it is on the left, the control on the right. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,20,0,6" />
            </Style>
            <Style x:Key="Description" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Problem" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="ShortcutButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="168" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            </Style>
        </Grid.Resources>

        <ScrollViewer>
            <StackPanel Margin="28,20,28,28" MaxWidth="760" Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="Shortcuts" Style="{StaticResource Section}" />
                <TextBlock
                    Margin="2,-2,0,6"
                    Style="{StaticResource Description}"
                    Text="Click a shortcut, then press the keys you want. Esc cancels, Backspace turns it off." />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Capture" />
                            <TextBlock Style="{StaticResource Description}" Text="Select a region or click a window, then edit it." />
                            <TextBlock x:Name="CaptureProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="CaptureShortcut" Style="{StaticResource ShortcutButton}" />
                            <Button x:Name="CaptureReset" ToolTipService.ToolTip="Reset to the default" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Scrolling capture" />
                            <TextBlock Style="{StaticResource Description}" Text="Capture more than fits on screen by scrolling. Press it again to finish." />
                            <TextBlock x:Name="ScrollingProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="ScrollingShortcut" Style="{StaticResource ShortcutButton}" />
                            <Button x:Name="ScrollingReset" ToolTipService.ToolTip="Reset to the default" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Copy text" />
                            <TextBlock Style="{StaticResource Description}" Text="Select a region and copy the text in it." />
                            <TextBlock x:Name="CopyTextProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="CopyTextShortcut" Style="{StaticResource ShortcutButton}" />
                            <Button x:Name="CopyTextReset" ToolTipService.ToolTip="Reset to the default" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="General" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource Description}" Text="Be in the tray, with your pins, after you sign in." />
                            <TextBlock x:Name="StartWithWindowsProblem" Style="{StaticResource Problem}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartWithWindows" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Magnifier while capturing" />
                            <TextBlock Style="{StaticResource Description}" Text="Shows the pixels and color under the cursor. M toggles it while capturing." />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShowMagnifier" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Close the editor after copying or saving" />
                            <TextBlock Style="{StaticResource Description}" Text="Turn off to keep editing after Copy or Save." />
                        </StackPanel>
                        <ToggleSwitch x:Name="CloseAfterExport" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Keep copies out of clipboard history" />
                            <TextBlock Style="{StaticResource Description}" Text="Copied captures and text won't appear in Win + V history or sync to your other devices. Pasting still works." />
                        </StackPanel>
                        <ToggleSwitch x:Name="KeepOutOfHistory" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" />
                    </Grid>
                </Border>

                <TextBlock Text="Beautify" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Beautify new captures" />
                            <TextBlock Style="{StaticResource Description}" Text="Start every capture on a gradient backdrop with rounded corners and a shadow." />
                        </StackPanel>
                        <ToggleSwitch x:Name="BeautifyByDefault" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Backdrop" />
                            <TextBlock Style="{StaticResource Description}" Text="The editor remembers the last one you picked." />
                        </StackPanel>
                        <ComboBox x:Name="BeautifyPreset" Grid.Column="1" MinWidth="168" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Padding" />
                            <TextBlock Style="{StaticResource Description}" Text="Space around the capture on the backdrop." />
                        </StackPanel>
                        <Slider x:Name="BeautifyPadding" Grid.Column="1" Width="168" Minimum="16" Maximum="160" StepFrequency="8" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <HyperlinkButton x:Name="OpenFile" Margin="0,16,0,0" Content="Edit the settings file (for colors, tool sizes and more)" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
