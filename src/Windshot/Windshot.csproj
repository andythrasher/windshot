<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 and later. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Windshot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\Windshot.ico</ApplicationIcon>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it, dotnet publish leaves out Windshot.pri and the compiled XAML (.xbf),
         and the editor window fails to load. Nothing is packaged as MSIX. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- The UI is English-only, so skip .NET's translated framework messages (~9 MB). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Release builds leave out the parts of .NET and the Windows API bindings that are never
    used (320 MB → ~105 MB installed). WinForms isn't officially supported with trimming, so
    the SDK refuses unless told otherwise; the tray, overlay, pins and HUD are covered by the
    release test pass. JSON uses generated code (JsonContext) instead of reflection.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>  </PropertyGroup>

  <!--
    The Microsoft Store package (tools/package.ps1 passes -p:StorePackage=true). It relies on
    the shared Windows App SDK runtime package, which the Store installs alongside, instead of
    carrying its own copy; .NET is still included. The Store signs the package on submission.
  -->
  <PropertyGroup Condition="'$(StorePackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WinForms is used only for the tray icon, hotkey sink and the capture overlay (it shows
      instantly and works in raw physical pixels). Referenced directly instead of via
      UseWindowsForms, which would drag in WPF's XAML compiler and clash with WinUI's.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also loaded at runtime for the tray and window icons. -->
    <Content Include="Assets\Windshot.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.cur" CopyToOutputDirectory="PreserveNewest" />
    <!-- Start menu, taskbar and Store logos for the package; made by tools/make-store-assets.ps1. -->
    <Content Include="Assets\Package\*.png" Condition="'$(StorePackage)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Just the parts of the Windows App SDK in use (UI, windowing, runtime), not the
         Microsoft.WindowsAppSDK metapackage, which also ships ~60 MB of AI/ML, Widgets and
         Search runtimes. Win2D needs nothing more than WinUI. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

</Project>
