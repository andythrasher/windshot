<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windshot.Editing.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:Windshot.Editing"
    Title="Windshot">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="Root_KeyDown" PreviewKeyDown="Root_PreviewKeyDown" PreviewKeyUp="Root_PreviewKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Icon-only, like Snipping Tool; labels live in the tooltips. When the window is too
             narrow, commands move from the right end into the "…" menu (where they show their
             labels); the Layers toggle stays pinned to the window's right edge. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <!-- Compact, Snipping Tool-sized buttons; the defaults leave room for labels. -->
                <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                    <Setter Property="Width" Value="44" />
                </Style>
                <Style TargetType="AppBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
                    <Setter Property="Width" Value="44" />
                </Style>
            </Grid.Resources>
        <CommandBar
            x:Name="Toolbar"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True"
            DynamicOverflowItemsChanging="Toolbar_DynamicOverflowItemsChanging">
            <!-- Icons are Fluent System Icons, assigned in code (see InitializeIcons). -->
            <AppBarButton x:Name="SaveButton" Label="Save" Click="Save_Click" ToolTipService.ToolTip="Save (Ctrl+S)" />
            <AppBarButton x:Name="CopyButton" Label="Copy" Click="Copy_Click" ToolTipService.ToolTip="Copy image (Ctrl+C)" />
            <AppBarSeparator />
            <AppBarButton x:Name="UndoButton" Label="Undo" Click="Undo_Click" IsEnabled="False" ToolTipService.ToolTip="Undo (Ctrl+Z)" />
            <AppBarButton x:Name="RedoButton" Label="Redo" Click="Redo_Click" IsEnabled="False" ToolTipService.ToolTip="Redo (Ctrl+Y)" />
            <AppBarSeparator />
            <AppBarToggleButton Label="Select" Click="ToolButton_Click" Tag="Select" ToolTipService.ToolTip="Select (V)" />
            <AppBarToggleButton Label="Arrow" Click="ToolButton_Click" Tag="Arrow" ToolTipService.ToolTip="Arrow (A)" />
            <AppBarToggleButton Label="Shapes" Click="ToolButton_Click" Tag="Rectangle" ToolTipService.ToolTip="Shapes (R): rectangle, ellipse, triangle or polygon" />
            <AppBarToggleButton Label="Text" Click="ToolButton_Click" Tag="Text" ToolTipService.ToolTip="Text (T)" />
            <AppBarToggleButton Label="Blur" Click="ToolButton_Click" Tag="Blur" ToolTipService.ToolTip="Blur (B)" />
            <AppBarToggleButton Label="Step" Click="ToolButton_Click" Tag="Step" ToolTipService.ToolTip="Numbered step (N)" />
            <AppBarToggleButton Label="Highlighter" Click="ToolButton_Click" Tag="Highlighter" ToolTipService.ToolTip="Highlighter (H)" />
            <AppBarToggleButton Label="Spotlight" Click="ToolButton_Click" Tag="Spotlight" ToolTipService.ToolTip="Spotlight (S)" />
            <AppBarToggleButton Label="Crop" Click="ToolButton_Click" Tag="Crop" ToolTipService.ToolTip="Crop (C). Drag the edges or draw a new area; Enter applies, Esc cancels." />
            <AppBarSeparator />
            <AppBarElementContainer x:Name="BeautifyContainer" VerticalContentAlignment="Center">
                <!-- Toggle on the left part; the arrow opens backdrop presets and padding. -->
                <ToggleSplitButton
                    x:Name="BeautifyButton"
                    Margin="4,0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsCheckedChanged="BeautifyButton_IsCheckedChanged"
                    ToolTipService.ToolTip="Beautify: gradient backdrop, rounded corners and shadow">
                    <ToggleSplitButton.Flyout>
                        <!-- Unconfined like the color menu, so it opens above the "…" menu too. -->
                        <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                            <StackPanel x:Name="BeautifyFlyoutContent" Width="236" Spacing="8">
                                <TextBlock Text="Backdrop" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <VariableSizedWrapGrid x:Name="BackdropSwatches" Orientation="Horizontal" MaximumRowsOrColumns="4" />
                                <TextBlock Text="Padding" />
                                <Slider x:Name="PaddingSlider" Minimum="16" Maximum="160" StepFrequency="8" />
                            </StackPanel>
                        </Flyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
            </AppBarElementContainer>
            <AppBarSeparator />
            <AppBarButton x:Name="PinButton" Label="Pin" Click="Pin_Click" ToolTipService.ToolTip="Pin to screen (Ctrl+P)" />
            <AppBarButton x:Name="CopyTextButton" Label="Copy text" Click="CopyText_Click" ToolTipService.ToolTip="Copy text (Ctrl+Shift+C)" />
        </CommandBar>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Collapsed">
                <AppBarToggleButton x:Name="LayersButton" Label="Layers" Click="LayersButton_Click" ToolTipService.ToolTip="Layers (L)" />
            </CommandBar>
        </Grid>

        <!-- The options bar: settings for the selected layer, or else for the current tool,
             like the options bar in photo editors. It's always there, so the canvas doesn't
             jump when the selection changes; what's on it does. -->
        <CommandBar
            x:Name="OptionsBar"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True"
            DynamicOverflowItemsChanging="Toolbar_DynamicOverflowItemsChanging">
            <!-- The shape tool's shapes, icon-only like the tools; icons are assigned in code. -->
            <AppBarToggleButton x:Name="ShapeRectangleButton" Width="44" LabelPosition="Collapsed" Label="Rectangle" Click="ShapeButton_Click" Tag="Rectangle" ToolTipService.ToolTip="Rectangle" />
            <AppBarToggleButton x:Name="ShapeEllipseButton" Width="44" LabelPosition="Collapsed" Label="Ellipse" Click="ShapeButton_Click" Tag="Ellipse" ToolTipService.ToolTip="Ellipse" />
            <AppBarToggleButton x:Name="ShapeTriangleButton" Width="44" LabelPosition="Collapsed" Label="Triangle" Click="ShapeButton_Click" Tag="Triangle" ToolTipService.ToolTip="Triangle" />
            <AppBarToggleButton x:Name="ShapePolygonButton" Width="44" LabelPosition="Collapsed" Label="Polygon" Click="ShapeButton_Click" Tag="Polygon" ToolTipService.ToolTip="Polygon: click each corner; click the first corner, double-click or press Enter to finish" />
            <AppBarToggleButton x:Name="ShapeStickerButton" Width="44" LabelPosition="Collapsed" Label="Sticker" Click="ShapeButton_Click" Tag="Sticker" ToolTipService.ToolTip="Stickers: pick one, then click to place it or drag to size it">
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="StickerFlyout" Placement="Bottom" ShouldConstrainToRootBounds="False">
                        <VariableSizedWrapGrid x:Name="StickerGrid" Orientation="Horizontal" MaximumRowsOrColumns="6" />
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </AppBarToggleButton>
            <AppBarSeparator x:Name="ShapeSeparator" />
            <AppBarElementContainer x:Name="SizeContainer" VerticalContentAlignment="Center" ToolTipService.ToolTip="Size ([ and ])">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                    <TextBlock Text="Size" VerticalAlignment="Center" />
                    <Slider
                        x:Name="WeightSlider"
                        Width="120"
                        VerticalAlignment="Center"
                        Minimum="1"
                        Maximum="10"
                        StepFrequency="1"
                        IsThumbToolTipEnabled="True" />
                </StackPanel>
            </AppBarElementContainer>
            <AppBarElementContainer x:Name="ColorContainer" VerticalContentAlignment="Center">
                <DropDownButton
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="4,0"
                    ToolTipService.ToolTip="Color (1–8)">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- Outlined so the white swatch stays visible on a light toolbar. -->
                        <Ellipse
                            x:Name="ColorSwatch"
                            Width="18"
                            Height="18"
                            Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                            StrokeThickness="1" />
                        <TextBlock x:Name="ColorLabel" Text="Color" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <!-- Free to extend past the window's bottom: confined to the window, it
                             would slide up over the toolbar once the color wheel is open, and
                             open behind the "…" menu, which is a window of its own. -->
                        <Flyout x:Name="ColorFlyout" Placement="Bottom" ShouldConstrainToRootBounds="False">
                            <StackPanel x:Name="ColorFlyoutContent" Spacing="12">
                                <!-- Switching sets recolors what's drawn to the new set's matching colors. -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colors" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ColorSetPicker" Grid.Column="1" HorizontalAlignment="Stretch" />
                                </Grid>
                                <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="8" />
                                <ToggleButton x:Name="MoreColorsButton" Content="More colors…" HorizontalAlignment="Stretch" />
                                <ColorPicker
                                    x:Name="MoreColors"
                                    Visibility="Collapsed"
                                    ColorSpectrumShape="Ring"
                                    IsAlphaEnabled="False"
                                    IsColorPreviewVisible="False"
                                    IsColorChannelTextInputVisible="False"
                                    IsHexInputVisible="True"
                                    IsMoreButtonVisible="False" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </AppBarElementContainer>
            <AppBarElementContainer x:Name="BlendContainer" Visibility="Collapsed" VerticalContentAlignment="Center" ToolTipService.ToolTip="How the highlight mixes with what's under it">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,4,0">
                    <TextBlock Text="Blend" VerticalAlignment="Center" />
                    <ComboBox x:Name="BlendPicker" Width="128" VerticalAlignment="Center" />
                </StackPanel>
            </AppBarElementContainer>
            <AppBarElementContainer x:Name="FontContainer" Visibility="Collapsed" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,4,0">
                    <TextBlock Text="Font" VerticalAlignment="Center" />
                    <!-- Each font is listed in its own typeface. -->
                    <ComboBox x:Name="FontPicker" Width="168" VerticalAlignment="Center" />
                </StackPanel>
            </AppBarElementContainer>
            <AppBarToggleButton
                x:Name="TextBackgroundButton"
                Label="Text background"
                Visibility="Collapsed"
                Click="TextBackgroundButton_Click"
                ToolTipService.ToolTip="Text background: set the text on a box of the current color" />
            <AppBarToggleButton
                x:Name="PixelateButton"
                Label="Pixelate"
                Visibility="Collapsed"
                Click="PixelateButton_Click"
                ToolTipService.ToolTip="Pixelate (P). Safer than a smooth blur for hiding text." />
            <AppBarToggleButton
                x:Name="FillButton"
                Label="Fill"
                Visibility="Collapsed"
                Click="FillButton_Click"
                ToolTipService.ToolTip="Fill (F): fill the shape with its color. Also handy for covering something up." />
            <AppBarElementContainer x:Name="HintContainer" Visibility="Collapsed" VerticalContentAlignment="Center">
                <TextBlock x:Name="OptionsHint" Margin="12,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </AppBarElementContainer>
        </CommandBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <!-- Transparent background makes the whole area hit-testable, not just drawn pixels. -->
        <local:CursorHost
            x:Name="CanvasHost"
            Background="Transparent"
            PointerPressed="Canvas_PointerPressed"
            PointerMoved="Canvas_PointerMoved"
            PointerReleased="Canvas_PointerReleased"
            PointerWheelChanged="Canvas_PointerWheelChanged"
            DoubleTapped="Canvas_DoubleTapped">
            <canvas:CanvasControl
                x:Name="Canvas"
                ClearColor="Transparent"
                CreateResources="Canvas_CreateResources"
                Draw="Canvas_Draw" />
            <!-- Hosts the inline text box while a text annotation is being typed. -->
            <Canvas x:Name="TextLayer" />
            <!-- Zoom readout; click to switch between fit and actual pixels. -->
            <Button
                x:Name="ZoomButton"
                Margin="12"
                Padding="10,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MinWidth="64"
                Click="ZoomButton_Click"
                ToolTipService.ToolTip="Zoom: scroll, Ctrl+= / Ctrl+-, Ctrl+0 to fit, Ctrl+1 for actual pixels. Space+drag or middle-drag to pan. Click to switch between fit and 100%." />
        </local:CursorHost>

            <!-- Layers, topmost first; the screenshot is pinned at the bottom. Rows are built in code. -->
            <Border
                x:Name="LayersPanel"
                Grid.Column="1"
                Width="272"
                Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid RowSpacing="4" Padding="8,12,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,0,0,4" Text="Layers" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ListView
                        x:Name="LayerList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True" />
                    <!-- The screenshot: always the bottom layer, so it's not in the reorderable list. -->
                    <Grid
                        x:Name="ImageLayerRow"
                        Grid.Row="2"
                        Margin="4,0,4,0"
                        Padding="12,0,4,0"
                        Height="40"
                        CornerRadius="4"
                        ColumnSpacing="10"
                        Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="ImageLayerIcon" VerticalAlignment="Center" />
                        <TextBlock x:Name="ImageLayerName" Grid.Column="1" Text="Screenshot" VerticalAlignment="Center" />
                        <Button x:Name="ImageLayerEye" Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Show or hide" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="8,8,4,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" VerticalAlignment="Center" />
                        <Slider x:Name="LayerOpacity" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center" IsEnabled="False" />
                        <Button x:Name="DeleteLayerButton" Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" IsEnabled="False" ToolTipService.ToolTip="Delete layer (Delete)" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
